CAPTURE_ROOT = Path(
    "/var/lib/libvirt/images/"
    "unidac-lab/captures"
)

CAPTURE_ID_RE = re.compile(
    r"^cap-[a-f0-9]{32}$"
)

CAPTURE_PORT_RE = re.compile(
    r"^(port|nic)([1-9][0-9]{0,2})$"
)

CAPTURE_NETWORK_RE = re.compile(
    r"^(default|ulab-net-[a-f0-9]{8})$"
)

CAPTURE_INTERFACE_RE = re.compile(
    r"^vnet[0-9]+$"
)


def validate_capture_id(
    capture_id,
):
    if not CAPTURE_ID_RE.fullmatch(
        capture_id or ""
    ):
        fail(
            "Capture ID invalido: "
            f"{capture_id}"
        )


def capture_paths(
    capture_id,
):
    validate_capture_id(
        capture_id
    )

    return {
        "pcap":
            CAPTURE_ROOT /
            f"{capture_id}.pcap",

        "pid":
            CAPTURE_ROOT /
            f"{capture_id}.pid",

        "log":
            CAPTURE_ROOT /
            f"{capture_id}.log",
    }


def capture_process_matches(
    pid,
    pcap_path,
):
    proc_path = Path(
        f"/proc/{pid}/cmdline"
    )

    if not proc_path.exists():
        return False


    try:
        command = (
            proc_path
            .read_bytes()
            .replace(
                b"\x00",
                b" ",
            )
            .decode(
                "utf-8",
                errors="replace",
            )
        )

    except OSError:
        return False


    return (
        "tcpdump" in command
        and
        str(pcap_path) in command
    )


def resolve_capture_interface(
    conn,
    domain_name,
    port_name,
    expected_network,
):
    validate_managed_domain_name(
        domain_name
    )


    match = CAPTURE_PORT_RE.fullmatch(
        port_name or ""
    )

    if not match:
        fail(
            "Porta nao suportada "
            "para captura: "
            f"{port_name}"
        )


    if is_adopted_domain_name(
        domain_name
    ):
        if not ADOPTED_NETWORK_RE.fullmatch(
            expected_network or ""
        ):
            fail(
                "Rede adotada invalida para captura: "
                f"{expected_network}"
            )

    elif not CAPTURE_NETWORK_RE.fullmatch(
        expected_network or ""
    ):
        fail(
            "Rede invalida para captura: "
            f"{expected_network}"
        )


    domain = get_managed_domain(
        conn,
        domain_name,
    )


    if not domain.isActive():
        fail(
            "VM precisa estar running "
            "para captura: "
            f"{domain_name}"
        )


    root = ET.fromstring(
        domain.XMLDesc(0)
    )


    interfaces = root.findall(
        "./devices/interface"
    )


    index = int(
        match.group(2)
    ) - 1


    if index >= len(interfaces):
        fail(
            "Porta nao existe no dominio: "
            f"{port_name}"
        )


    interface = interfaces[
        index
    ]


    source = interface.find(
        "source"
    )

    actual_network = (
        source.get("network")
        if source is not None
        else None
    )


    if (
        actual_network
        != expected_network
    ):
        fail(
            "Rede runtime diverge do "
            "Desired State para "
            f"{port_name}: "
            f"{actual_network}"
        )


    target = interface.find(
        "target"
    )

    target_dev = (
        target.get("dev")
        if target is not None
        else None
    )


    if not CAPTURE_INTERFACE_RE.fullmatch(
        target_dev or ""
    ):
        fail(
            "Interface runtime invalida "
            "para captura."
        )


    mac_node = interface.find(
        "mac"
    )

    mac = (
        mac_node.get("address")
        if mac_node is not None
        else None
    )


    return {
        "interface":
            target_dev,

        "network":
            actual_network,

        "mac":
            mac,
    }


def capture_start(
    capture_id,
    domain_name,
    port_name,
    expected_network,
):
    import shutil
    import time

    require_root()

    paths = capture_paths(
        capture_id
    )


    CAPTURE_ROOT.mkdir(
        parents=True,
        exist_ok=True,
    )

    CAPTURE_ROOT.chmod(
        0o755
    )


    if paths["pcap"].exists():
        fail(
            "Capture ID ja utilizado: "
            f"{capture_id}"
        )


    conn = get_connection()

    try:
        runtime = (
            resolve_capture_interface(
                conn,
                domain_name,
                port_name,
                expected_network,
            )
        )

    finally:
        conn.close()


    tcpdump = shutil.which(
        "tcpdump"
    )

    if not tcpdump:
        fail(
            "tcpdump nao encontrado."
        )


    with paths["log"].open(
        "wb"
    ) as log_handle:
        process = subprocess.Popen(
            [
                tcpdump,
                "-U",
                "-n",
                "-i",
                runtime[
                    "interface"
                ],
                "-s",
                "0",
                "-w",
                str(
                    paths["pcap"]
                ),
            ],
            stdin=
                subprocess.DEVNULL,
            stdout=
                subprocess.DEVNULL,
            stderr=
                log_handle,
            start_new_session=
                True,
            close_fds=
                True,
        )


    time.sleep(
        0.35
    )


    if process.poll() is not None:
        message = ""

        if paths["log"].exists():
            message = (
                paths["log"]
                .read_text(
                    errors="replace"
                )
                .strip()
            )

        try:
            paths["pcap"].unlink()

        except FileNotFoundError:
            pass

        fail(
            "Falha iniciando tcpdump: "
            + (
                message
                or
                f"exit={process.returncode}"
            )
        )


    paths["pid"].write_text(
        str(
            process.pid
        )
    )

    paths["pid"].chmod(
        0o644
    )


    if paths["pcap"].exists():
        paths["pcap"].chmod(
            0o644
        )


    output(
        {
            "status":
                "running",

            "capture_id":
                capture_id,

            "domain":
                domain_name,

            "port":
                port_name,

            "network":
                expected_network,

            "interface":
                runtime[
                    "interface"
                ],

            "mac":
                runtime[
                    "mac"
                ],

            "pcap":
                str(
                    paths["pcap"]
                ),

            "pid":
                process.pid,
        }
    )


def capture_status(
    capture_id,
):
    require_root()

    paths = capture_paths(
        capture_id
    )


    pid = None

    if paths["pid"].exists():
        try:
            pid = int(
                paths["pid"]
                .read_text()
                .strip()
            )

        except (
            TypeError,
            ValueError,
        ):
            pid = None


    running = (
        pid is not None
        and
        capture_process_matches(
            pid,
            paths["pcap"],
        )
    )


    if running:
        status = "running"

    elif paths["pcap"].exists():
        status = "finished"

    else:
        status = "absent"


    size_bytes = (
        paths["pcap"].stat().st_size
        if paths["pcap"].exists()
        else 0
    )


    output(
        {
            "status":
                status,

            "capture_id":
                capture_id,

            "running":
                running,

            "pcap":
                str(
                    paths["pcap"]
                ),

            "size_bytes":
                size_bytes,
        }
    )


def capture_stop(
    capture_id,
):
    import os
    import signal
    import time

    require_root()

    paths = capture_paths(
        capture_id
    )


    if not paths["pid"].exists():
        if paths["pcap"].exists():
            paths["pcap"].chmod(
                0o644
            )

            output(
                {
                    "status":
                        "finished",

                    "capture_id":
                        capture_id,

                    "running":
                        False,

                    "pcap":
                        str(
                            paths["pcap"]
                        ),

                    "size_bytes":
                        paths["pcap"]
                        .stat()
                        .st_size,
                }
            )

            return


        output(
            {
                "status":
                    "absent",

                "capture_id":
                    capture_id,

                "running":
                    False,

                "pcap":
                    str(
                        paths["pcap"]
                    ),

                "size_bytes":
                    0,
            }
        )

        return


    try:
        pid = int(
            paths["pid"]
            .read_text()
            .strip()
        )

    except (
        TypeError,
        ValueError,
    ):
        paths["pid"].unlink(
            missing_ok=True
        )

        fail(
            "PID de captura invalido."
        )


    if capture_process_matches(
        pid,
        paths["pcap"],
    ):
        try:
            os.kill(
                pid,
                signal.SIGINT,
            )

        except ProcessLookupError:
            pass


        for _ in range(50):
            if not capture_process_matches(
                pid,
                paths["pcap"],
            ):
                break

            time.sleep(
                0.1
            )


        if capture_process_matches(
            pid,
            paths["pcap"],
        ):
            try:
                os.kill(
                    pid,
                    signal.SIGTERM,
                )

            except ProcessLookupError:
                pass


    paths["pid"].unlink(
        missing_ok=True
    )


    if paths["pcap"].exists():
        paths["pcap"].chmod(
            0o644
        )


    size_bytes = (
        paths["pcap"].stat().st_size
        if paths["pcap"].exists()
        else 0
    )


    output(
        {
            "status":
                "stopped",

            "capture_id":
                capture_id,

            "running":
                False,

            "pcap":
                str(
                    paths["pcap"]
                ),

            "size_bytes":
                size_bytes,
        }
    )



def validate_netem_values(
    delay_ms,
    jitter_ms,
    loss_pct,
    rate_mbit,
):
    try:
        delay_ms = int(
            delay_ms
        )

        jitter_ms = int(
            jitter_ms
        )

        loss_pct = float(
            loss_pct
        )

        rate_mbit = int(
            rate_mbit
        )

    except (
        TypeError,
        ValueError,
    ):
        fail(
            "Parametros Netem invalidos."
        )


    if not 0 <= delay_ms <= 5000:
        fail(
            "Delay fora do limite "
            "0..5000 ms."
        )


    if not 0 <= jitter_ms <= 5000:
        fail(
            "Jitter fora do limite "
            "0..5000 ms."
        )


    if (
        jitter_ms > 0
        and delay_ms == 0
    ):
        fail(
            "Jitter exige delay maior "
            "que zero."
        )


    if not 0 <= loss_pct <= 100:
        fail(
            "Loss fora do limite "
            "0..100%."
        )


    if not 0 <= rate_mbit <= 100000:
        fail(
            "Bandwidth fora do limite "
            "0..100000 Mbit."
        )


    return {
        "delay_ms":
            delay_ms,

        "jitter_ms":
            jitter_ms,

        "loss_pct":
            loss_pct,

        "rate_mbit":
            rate_mbit,
    }


def get_tc_binary():
    import shutil

    tc = shutil.which(
        "tc"
    )

    if not tc:
        fail(
            "tc nao encontrado."
        )

    return tc


def tc_qdisc_text(
    interface_name,
):
    tc = get_tc_binary()


    process = subprocess.run(
        [
            tc,
            "qdisc",
            "show",
            "dev",
            interface_name,
        ],
        capture_output=True,
        text=True,
        check=False,
        timeout=10,
    )


    if process.returncode != 0:
        fail(
            "Falha consultando qdisc: "
            + (
                process.stderr.strip()
                or
                process.stdout.strip()
            )
        )


    return (
        process.stdout.strip()
    )


def resolve_netem_interface(
    domain_name,
    port_name,
    network_name,
):
    conn = get_connection()

    try:
        return resolve_capture_interface(
            conn,
            domain_name,
            port_name,
            network_name,
        )

    finally:
        conn.close()


def link_netem_status(
    domain_name,
    port_name,
    network_name,
):
    require_root()

    runtime = resolve_netem_interface(
        domain_name,
        port_name,
        network_name,
    )


    qdisc = tc_qdisc_text(
        runtime["interface"]
    )


    enabled = (
        " netem " in
        f" {qdisc} "
    )


    output(
        {
            "status":
                "active"
                if enabled
                else "clear",

            "enabled":
                enabled,

            "domain":
                domain_name,

            "port":
                port_name,

            "network":
                network_name,

            "interface":
                runtime[
                    "interface"
                ],

            "qdisc":
                qdisc,
        }
    )


def link_netem_clear(
    domain_name,
    port_name,
    network_name,
):
    require_root()

    runtime = resolve_netem_interface(
        domain_name,
        port_name,
        network_name,
    )


    current = tc_qdisc_text(
        runtime["interface"]
    )


    if " netem " not in (
        f" {current} "
    ):
        output(
            {
                "status":
                    "clear",

                "changed":
                    False,

                "domain":
                    domain_name,

                "port":
                    port_name,

                "network":
                    network_name,

                "interface":
                    runtime[
                        "interface"
                    ],

                "qdisc":
                    current,
            }
        )

        return


    tc = get_tc_binary()


    process = subprocess.run(
        [
            tc,
            "qdisc",
            "del",
            "dev",
            runtime[
                "interface"
            ],
            "root",
        ],
        capture_output=True,
        text=True,
        check=False,
        timeout=10,
    )


    if process.returncode != 0:
        fail(
            "Falha removendo Netem: "
            + (
                process.stderr.strip()
                or
                process.stdout.strip()
            )
        )


    output(
        {
            "status":
                "clear",

            "changed":
                True,

            "domain":
                domain_name,

            "port":
                port_name,

            "network":
                network_name,

            "interface":
                runtime[
                    "interface"
                ],

            "qdisc":
                tc_qdisc_text(
                    runtime[
                        "interface"
                    ]
                ),
        }
    )


def link_netem_set(
    domain_name,
    port_name,
    network_name,
    delay_ms,
    jitter_ms,
    loss_pct,
    rate_mbit,
):
    require_root()

    values = validate_netem_values(
        delay_ms,
        jitter_ms,
        loss_pct,
        rate_mbit,
    )


    if (
        values["delay_ms"] == 0
        and
        values["jitter_ms"] == 0
        and
        values["loss_pct"] == 0
        and
        values["rate_mbit"] == 0
    ):
        link_netem_clear(
            domain_name,
            port_name,
            network_name,
        )

        return


    runtime = resolve_netem_interface(
        domain_name,
        port_name,
        network_name,
    )


    command = [
        get_tc_binary(),
        "qdisc",
        "replace",
        "dev",
        runtime[
            "interface"
        ],
        "root",
        "netem",
    ]


    if values["delay_ms"] > 0:
        command.extend(
            [
                "delay",
                f'{values["delay_ms"]}ms',
            ]
        )

        if values[
            "jitter_ms"
        ] > 0:
            command.append(
                f'{values["jitter_ms"]}ms'
            )


    if values["loss_pct"] > 0:
        command.extend(
            [
                "loss",
                f'{values["loss_pct"]}%',
            ]
        )


    if values["rate_mbit"] > 0:
        command.extend(
            [
                "rate",
                f'{values["rate_mbit"]}mbit',
            ]
        )


    process = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=False,
        timeout=10,
    )


    if process.returncode != 0:
        fail(
            "Falha configurando Netem: "
            + (
                process.stderr.strip()
                or
                process.stdout.strip()
            )
        )


    output(
        {
            "status":
                "active",

            "enabled":
                True,

            "domain":
                domain_name,

            "port":
                port_name,

            "network":
                network_name,

            "interface":
                runtime[
                    "interface"
                ],

            "delay_ms":
                values[
                    "delay_ms"
                ],

            "jitter_ms":
                values[
                    "jitter_ms"
                ],

            "loss_pct":
                values[
                    "loss_pct"
                ],

            "rate_mbit":
                values[
                    "rate_mbit"
                ],

            "qdisc":
                tc_qdisc_text(
                    runtime[
                        "interface"
                    ]
                ),
        }
    )


