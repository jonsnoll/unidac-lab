#!/usr/bin/python3

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

import libvirt


PROJECT_ROOT = Path(
    "/home/felipe/unidac-lab"
)

PROJECT_IMAGE_STORE = (
    PROJECT_ROOT
    / "images"
    / "store"
)

RUNTIME_ROOT = Path(
    "/var/lib/libvirt/images/unidac-lab"
)

RUNTIME_IMAGE_STORE = (
    RUNTIME_ROOT
    / "store"
)

RUNTIME_LABS = (
    RUNTIME_ROOT
    / "labs"
)


NETWORK_RE = re.compile(
    r"^ulab-net-[a-f0-9]{8}$"
)

BRIDGE_RE = re.compile(
    r"^ulb[a-f0-9]{8}$"
)

SAFE_ID_RE = re.compile(
    r"^[a-z0-9][a-z0-9-]{1,62}$"
)

DOMAIN_RE = re.compile(
    r"^ulab-[a-z0-9][a-z0-9-]{1,62}$"
)


def silent_libvirt_error(
    _context,
    _error,
):
    return None


libvirt.registerErrorHandler(
    silent_libvirt_error,
    None,
)


def output(data):
    print(
        json.dumps(
            data,
            indent=2,
        )
    )


def fail(message, code=1):
    output(
        {
            "status": "error",
            "message": message,
        }
    )

    raise SystemExit(code)


def require_root():
    if os.geteuid() != 0:
        fail(
            "unidac-lab-agent precisa "
            "ser executado como root."
        )


def validate_id(
    value,
    label,
):
    if not SAFE_ID_RE.fullmatch(
        value
    ):
        fail(
            f"{label} invalido: "
            f"{value}"
        )


def ensure_runtime_dir(path):
    path.mkdir(
        parents=True,
        exist_ok=True,
    )

    shutil.chown(
        path,
        user="libvirt-qemu",
        group="kvm",
    )

    os.chmod(
        path,
        0o755,
    )


def sha256_file(path):
    digest = hashlib.sha256()

    with path.open("rb") as file:
        while True:
            chunk = file.read(
                1024 * 1024
            )

            if not chunk:
                break

            digest.update(
                chunk
            )

    return digest.hexdigest()


def qemu_img_info(path):
    process = subprocess.run(
        [
            "qemu-img",
            "info",
            "--force-share",
            "--output=json",
            str(path),
        ],
        check=True,
        capture_output=True,
        text=True,
    )

    return json.loads(
        process.stdout
    )


def get_connection():
    conn = libvirt.open(
        "qemu:///system"
    )

    if conn is None:
        fail(
            "Nao foi possivel conectar "
            "ao libvirt."
        )

    return conn


def health():
    require_root()

    conn = get_connection()

    try:
        output(
            {
                "status": "ok",
                "component":
                    "unidac-lab-agent",
                "uid":
                    os.geteuid(),
                "libvirt_library":
                    libvirt.getVersion(),
                "hypervisor":
                    conn.getVersion(),
                "runtime_root":
                    str(RUNTIME_ROOT),
            }
        )

    finally:
        conn.close()


def network_ensure(
    network_name,
    bridge_name,
):
    require_root()

    if not NETWORK_RE.fullmatch(
        network_name
    ):
        fail(
            "Nome de rede invalido."
        )

    if not BRIDGE_RE.fullmatch(
        bridge_name
    ):
        fail(
            "Nome de bridge invalido."
        )


    conn = get_connection()

    try:
        try:
            network = (
                conn.networkLookupByName(
                    network_name
                )
            )

        except libvirt.libvirtError:
            network = None


        if network is not None:
            actual_bridge = (
                network.bridgeName()
            )

            if (
                actual_bridge
                != bridge_name
            ):
                fail(
                    "Rede existente usa "
                    "bridge inesperada: "
                    f"{actual_bridge}"
                )


            if not network.isActive():
                network.create()


            output(
                {
                    "status":
                        "exists",

                    "network":
                        network_name,

                    "bridge":
                        actual_bridge,

                    "active":
                        bool(
                            network.isActive()
                        ),

                    "persistent":
                        bool(
                            network.isPersistent()
                        ),
                }
            )

            return


        xml = f"""
<network>
  <name>{network_name}</name>
  <bridge
    name='{bridge_name}'
    stp='on'
    delay='0'
  />
</network>
""".strip()


        network = (
            conn.networkDefineXML(
                xml
            )
        )

        if network is None:
            fail(
                "Falha ao definir "
                "a rede libvirt."
            )


        network.create()

        network.setAutostart(
            False
        )


        output(
            {
                "status":
                    "created",

                "network":
                    network_name,

                "bridge":
                    network.bridgeName(),

                "active":
                    True,

                "persistent":
                    True,

                "autostart":
                    False,
            }
        )

    finally:
        conn.close()


def image_ensure(
    vendor,
    image_id,
):
    require_root()

    validate_id(
        vendor,
        "Vendor",
    )

    validate_id(
        image_id,
        "Image ID",
    )


    source = (
        PROJECT_IMAGE_STORE
        / vendor
        / image_id
        / "base.qcow2"
    )

    destination_dir = (
        RUNTIME_IMAGE_STORE
        / vendor
        / image_id
    )

    destination = (
        destination_dir
        / "base.qcow2"
    )


    if not source.is_file():
        fail(
            "Imagem de origem nao "
            f"encontrada: {source}"
        )


    info = qemu_img_info(
        source
    )

    if (
        info.get("format")
        != "qcow2"
    ):
        fail(
            "Imagem de origem nao "
            "e QCOW2 valida."
        )


    source_sha = (
        sha256_file(
            source
        )
    )


    ensure_runtime_dir(
        RUNTIME_ROOT
    )

    ensure_runtime_dir(
        RUNTIME_IMAGE_STORE
    )

    ensure_runtime_dir(
        RUNTIME_IMAGE_STORE
        / vendor
    )

    ensure_runtime_dir(
        destination_dir
    )


    if destination.exists():
        runtime_sha = (
            sha256_file(
                destination
            )
        )

        if (
            runtime_sha
            != source_sha
        ):
            fail(
                "Imagem runtime ja "
                "existe com SHA256 "
                "diferente."
            )


        shutil.chown(
            destination,
            user="libvirt-qemu",
            group="kvm",
        )

        os.chmod(
            destination,
            0o444,
        )


        output(
            {
                "status":
                    "exists",

                "vendor":
                    vendor,

                "image_id":
                    image_id,

                "runtime_path":
                    str(destination),

                "sha256":
                    runtime_sha,

                "read_only":
                    True,
            }
        )

        return


    temp_file = (
        destination_dir
        / ".base.qcow2.tmp"
    )


    try:
        if temp_file.exists():
            temp_file.unlink()


        shutil.copyfile(
            source,
            temp_file,
        )


        copied_sha = (
            sha256_file(
                temp_file
            )
        )

        if (
            copied_sha
            != source_sha
        ):
            fail(
                "SHA256 divergiu "
                "durante a copia."
            )


        shutil.chown(
            temp_file,
            user="libvirt-qemu",
            group="kvm",
        )

        os.chmod(
            temp_file,
            0o444,
        )


        os.replace(
            temp_file,
            destination,
        )

    finally:
        if temp_file.exists():
            temp_file.unlink()


    output(
        {
            "status":
                "created",

            "vendor":
                vendor,

            "image_id":
                image_id,

            "runtime_path":
                str(destination),

            "sha256":
                source_sha,

            "read_only":
                True,
        }
    )


def overlay_ensure(
    lab_id,
    domain_name,
    vendor,
    image_id,
):
    require_root()

    validate_id(
        lab_id,
        "Lab ID",
    )

    validate_id(
        vendor,
        "Vendor",
    )

    validate_id(
        image_id,
        "Image ID",
    )


    if not DOMAIN_RE.fullmatch(
        domain_name
    ):
        fail(
            "Nome de dominio "
            f"invalido: {domain_name}"
        )


    base = (
        RUNTIME_IMAGE_STORE
        / vendor
        / image_id
        / "base.qcow2"
    )


    if not base.is_file():
        fail(
            "Base runtime nao existe. "
            "Execute image-ensure "
            "primeiro."
        )


    lab_dir = (
        RUNTIME_LABS
        / lab_id
    )

    overlay = (
        lab_dir
        / f"{domain_name}.qcow2"
    )


    ensure_runtime_dir(
        RUNTIME_ROOT
    )

    ensure_runtime_dir(
        RUNTIME_LABS
    )

    ensure_runtime_dir(
        lab_dir
    )


    if overlay.exists():
        info = qemu_img_info(
            overlay
        )


        if (
            info.get("format")
            != "qcow2"
        ):
            fail(
                "Overlay existente "
                "nao e QCOW2."
            )


        backing = (
            info.get(
                "full-backing-filename"
            )
            or
            info.get(
                "backing-filename"
            )
        )


        if not backing:
            fail(
                "Overlay existente "
                "nao possui backing "
                "file."
            )


        backing_path = Path(
            backing
        )

        if not backing_path.is_absolute():
            backing_path = (
                overlay.parent
                / backing_path
            )


        if (
            backing_path.resolve()
            != base.resolve()
        ):
            fail(
                "Overlay existente "
                "aponta para backing "
                "file diferente."
            )


        shutil.chown(
            overlay,
            user="libvirt-qemu",
            group="kvm",
        )

        os.chmod(
            overlay,
            0o644,
        )


        output(
            {
                "status":
                    "exists",

                "domain":
                    domain_name,

                "overlay":
                    str(overlay),

                "backing":
                    str(base),

                "format":
                    "qcow2",
            }
        )

        return


    subprocess.run(
        [
            "qemu-img",
            "create",
            "-f",
            "qcow2",
            "-F",
            "qcow2",
            "-b",
            str(base),
            str(overlay),
        ],
        check=True,
        capture_output=True,
        text=True,
    )


    shutil.chown(
        overlay,
        user="libvirt-qemu",
        group="kvm",
    )

    os.chmod(
        overlay,
        0o644,
    )


    output(
        {
            "status":
                "created",

            "domain":
                domain_name,

            "overlay":
                str(overlay),

            "backing":
                str(base),

            "format":
                "qcow2",
        }
    )


def validate_managed_network(network_name):
    if network_name == "default":
        return

    if NETWORK_RE.fullmatch(
        network_name
    ):
        return

    fail(
        "Rede nao permitida pelo Agent: "
        f"{network_name}"
    )


def domain_mac(
    domain_name,
    interface_index,
):
    match = re.search(
        r"-([a-f0-9]{4})$",
        domain_name,
    )

    if not match:
        fail(
            "Dominio nao possui token "
            "hexadecimal para gerar MAC."
        )

    token = match.group(1)

    return (
        "52:54:00:"
        f"{token[:2]}:"
        f"{token[2:]}:"
        f"{interface_index:02x}"
    )


def expected_overlay_path(
    lab_id,
    domain_name,
):
    return (
        RUNTIME_LABS
        / lab_id
        / f"{domain_name}.qcow2"
    )


def resolve_vm_interfaces(
    interfaces,
):
    if not isinstance(
        interfaces,
        list,
    ):
        fail(
            "interfaces precisa ser uma lista."
        )

    if not interfaces:
        fail(
            "A VM precisa possuir "
            "ao menos uma interface."
        )


    connected_networks = []

    for item in interfaces:
        if not isinstance(
            item,
            dict,
        ):
            fail(
                "Interface invalida."
            )

        port = item.get(
            "port"
        )

        if (
            not isinstance(port, str)
            or
            not re.fullmatch(
                r"[A-Za-z0-9_.-]{1,32}",
                port,
            )
        ):
            fail(
                "Nome de porta invalido."
            )

        connected = bool(
            item.get("connected")
        )

        network = item.get(
            "network"
        )

        if connected:
            if not network:
                fail(
                    f"{port}: conectado "
                    "sem network."
                )

            validate_managed_network(
                network
            )

            connected_networks.append(
                network
            )


    fallback_network = next(
        (
            network
            for network
            in connected_networks
            if network != "default"
        ),
        (
            connected_networks[0]
            if connected_networks
            else "default"
        ),
    )


    resolved = []

    for index, item in enumerate(
        interfaces,
        start=1,
    ):
        connected = bool(
            item.get("connected")
        )

        network = item.get(
            "network"
        )

        if not connected:
            network = (
                network
                or fallback_network
            )

        validate_managed_network(
            network
        )

        resolved.append(
            {
                "port":
                    item["port"],

                "connected":
                    connected,

                "network":
                    network,

                "index":
                    index,
            }
        )

    return resolved


def validate_overlay_for_vm(
    overlay,
    vendor,
    image_id,
):
    if not overlay.is_file():
        fail(
            "Overlay nao existe. "
            "Execute overlay-ensure primeiro."
        )


    base = (
        RUNTIME_IMAGE_STORE
        / vendor
        / image_id
        / "base.qcow2"
    )

    if not base.is_file():
        fail(
            "Imagem base runtime nao existe."
        )


    info = qemu_img_info(
        overlay
    )


    if info.get("format") != "qcow2":
        fail(
            "Overlay nao e QCOW2."
        )


    backing = (
        info.get(
            "full-backing-filename"
        )
        or
        info.get(
            "backing-filename"
        )
    )


    if not backing:
        fail(
            "Overlay nao possui backing file."
        )


    backing_path = Path(
        backing
    )

    if not backing_path.is_absolute():
        backing_path = (
            overlay.parent
            / backing_path
        )


    if (
        backing_path.resolve()
        != base.resolve()
    ):
        fail(
            "Overlay aponta para "
            "imagem base diferente."
        )


def build_fortigate_xml(
    domain_name,
    memory_mb,
    vcpu,
    overlay,
    interfaces,
):
    interface_xml = []


    for item in interfaces:
        mac = domain_mac(
            domain_name,
            item["index"],
        )

        link = ""

        if not item["connected"]:
            link = (
                "\n"
                "      <link state='down'/>"
            )


        interface_xml.append(
            f"""
    <interface type='network'>
      <mac address='{mac}'/>
      <source network='{item["network"]}'/>
      <model type='virtio'/>{link}
    </interface>
""".rstrip()
        )


    memory_kib = (
        memory_mb * 1024
    )

    interface_block = (
        "\n\n".join(
            interface_xml
        )
    )


    return f"""
<domain type='kvm'>
  <name>{domain_name}</name>

  <memory unit='KiB'>{memory_kib}</memory>
  <currentMemory unit='KiB'>{memory_kib}</currentMemory>

  <vcpu placement='static'>{vcpu}</vcpu>

  <os>
    <type arch='x86_64'
          machine='pc-i440fx-noble-v2'>hvm</type>
    <boot dev='hd'/>
  </os>

  <features>
    <acpi/>
    <apic/>
  </features>

  <cpu mode='host-passthrough'
       check='none'
       migratable='on'/>

  <devices>

    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='{overlay}'/>
      <target dev='vda' bus='virtio'/>
    </disk>

{interface_block}

    <serial type='pty'>
      <target type='isa-serial'
              port='0'/>
    </serial>

    <console type='pty'>
      <target type='serial'
              port='0'/>
    </console>

  </devices>
</domain>
""".strip()


def validate_existing_vm(
    domain,
    domain_name,
    memory_mb,
    vcpu,
    overlay,
    interfaces,
):
    root = ET.fromstring(
        domain.XMLDesc(0)
    )

    mismatches = []


    os_type = root.find(
        "./os/type"
    )

    machine = (
        os_type.get("machine")
        if os_type is not None
        else None
    )

    if machine != "pc-i440fx-noble-v2":
        mismatches.append(
            "machine diferente"
        )


    try:
        actual_vcpu = int(
            root.findtext("vcpu")
        )

    except (
        TypeError,
        ValueError,
    ):
        actual_vcpu = None


    if actual_vcpu != vcpu:
        mismatches.append(
            "vCPU diferente"
        )


    memory = root.find(
        "memory"
    )

    actual_memory = None

    if memory is not None:
        try:
            actual_memory = int(
                memory.text
            )

        except (
            TypeError,
            ValueError,
        ):
            pass


        unit = (
            memory.get(
                "unit",
                "KiB",
            ).lower()
        )


        if (
            actual_memory is not None
            and unit == "mib"
        ):
            actual_memory *= 1024


    expected_memory = (
        memory_mb * 1024
    )


    if actual_memory != expected_memory:
        mismatches.append(
            "memoria diferente"
        )


    disk_source = None

    for disk in root.findall(
        "./devices/disk"
    ):
        if disk.get("device") != "disk":
            continue

        source = disk.find(
            "source"
        )

        if source is not None:
            disk_source = source.get(
                "file"
            )

        break


    if disk_source != str(overlay):
        mismatches.append(
            "disco diferente"
        )


    actual_interfaces = root.findall(
        "./devices/interface"
    )


    if (
        len(actual_interfaces)
        != len(interfaces)
    ):
        mismatches.append(
            "quantidade de interfaces diferente"
        )

    else:
        for index, (
            actual,
            expected,
        ) in enumerate(
            zip(
                actual_interfaces,
                interfaces,
            ),
            start=1,
        ):
            source = actual.find(
                "source"
            )

            actual_network = (
                source.get("network")
                if source is not None
                else None
            )


            if (
                actual_network
                != expected["network"]
            ):
                mismatches.append(
                    f"interface {index} "
                    "em rede diferente"
                )


            model = actual.find(
                "model"
            )

            actual_model = (
                model.get("type")
                if model is not None
                else None
            )

            if actual_model != "virtio":
                mismatches.append(
                    f"interface {index} "
                    "nao usa virtio"
                )


            mac = actual.find(
                "mac"
            )

            actual_mac = (
                mac.get("address")
                if mac is not None
                else None
            )


            expected_mac = domain_mac(
                domain_name,
                index,
            )


            if (
                actual_mac.lower()
                if actual_mac
                else None
            ) != expected_mac:
                mismatches.append(
                    f"interface {index} "
                    "possui MAC diferente"
                )


            link = actual.find(
                "link"
            )

            actual_down = (
                link is not None
                and
                link.get("state")
                == "down"
            )

            expected_down = (
                not expected[
                    "connected"
                ]
            )


            if (
                actual_down
                != expected_down
            ):
                mismatches.append(
                    f"interface {index} "
                    "possui link diferente"
                )


    if mismatches:
        fail(
            "VM existente diverge do "
            "Desired State: "
            + "; ".join(
                mismatches
            )
        )


def vm_ensure():
    require_root()


    try:
        spec = json.load(
            sys.stdin
        )

    except json.JSONDecodeError as error:
        fail(
            "JSON invalido para vm-ensure: "
            f"{error}"
        )


    if not isinstance(
        spec,
        dict,
    ):
        fail(
            "Spec precisa ser objeto JSON."
        )


    lab_id = spec.get(
        "lab_id"
    )

    domain_name = spec.get(
        "domain_name"
    )

    profile = spec.get(
        "profile"
    )

    vendor = spec.get(
        "vendor"
    )

    image_id = spec.get(
        "image_id"
    )


    validate_id(
        lab_id,
        "Lab ID",
    )

    validate_id(
        vendor,
        "Vendor",
    )

    validate_id(
        image_id,
        "Image ID",
    )


    if not DOMAIN_RE.fullmatch(
        domain_name or ""
    ):
        fail(
            "Nome de dominio invalido."
        )


    if profile != "fortigate-kvm":
        fail(
            "Perfil ainda nao suportado: "
            f"{profile}"
        )


    try:
        vcpu = int(
            spec.get("vcpu")
        )

        memory_mb = int(
            spec.get("memory_mb")
        )

    except (
        TypeError,
        ValueError,
    ):
        fail(
            "CPU ou memoria invalidos."
        )


    if not 1 <= vcpu <= 64:
        fail(
            "vCPU fora do limite."
        )


    if not 256 <= memory_mb <= 131072:
        fail(
            "Memoria fora do limite."
        )


    interfaces = resolve_vm_interfaces(
        spec.get("interfaces")
    )


    overlay = expected_overlay_path(
        lab_id,
        domain_name,
    )


    validate_overlay_for_vm(
        overlay,
        vendor,
        image_id,
    )


    conn = get_connection()


    try:
        for network_name in {
            item["network"]
            for item in interfaces
        }:
            try:
                network = (
                    conn.networkLookupByName(
                        network_name
                    )
                )

            except libvirt.libvirtError:
                fail(
                    "Rede necessaria nao existe: "
                    f"{network_name}"
                )


            if not network.isActive():
                fail(
                    "Rede necessaria esta inativa: "
                    f"{network_name}"
                )


        try:
            domain = conn.lookupByName(
                domain_name
            )

        except libvirt.libvirtError:
            domain = None


        if domain is not None:
            validate_existing_vm(
                domain,
                domain_name,
                memory_mb,
                vcpu,
                overlay,
                interfaces,
            )


            started = False


            if not domain.isActive():
                domain.create()

                started = True


            output(
                {
                    "status":
                        "exists",

                    "domain":
                        domain_name,

                    "state":
                        "running"
                        if domain.isActive()
                        else "shutoff",

                    "started":
                        started,

                    "overlay":
                        str(overlay),

                    "vcpu":
                        vcpu,

                    "memory_mb":
                        memory_mb,

                    "interfaces":
                        [
                            {
                                "port":
                                    item["port"],

                                "network":
                                    item["network"],

                                "connected":
                                    item["connected"],

                                "mac":
                                    domain_mac(
                                        domain_name,
                                        item["index"],
                                    ),
                            }
                            for item
                            in interfaces
                        ],
                }
            )

            return


        xml = build_fortigate_xml(
            domain_name,
            memory_mb,
            vcpu,
            overlay,
            interfaces,
        )


        domain = conn.defineXML(
            xml
        )


        if domain is None:
            fail(
                "Falha ao definir dominio."
            )


        try:
            domain.create()

        except Exception:
            try:
                domain.undefine()

            except Exception:
                pass

            raise


        output(
            {
                "status":
                    "created",

                "domain":
                    domain_name,

                "state":
                    "running",

                "started":
                    True,

                "overlay":
                    str(overlay),

                "vcpu":
                    vcpu,

                "memory_mb":
                    memory_mb,

                "interfaces":
                    [
                        {
                            "port":
                                item["port"],

                            "network":
                                item["network"],

                            "connected":
                                item["connected"],

                            "mac":
                                domain_mac(
                                    domain_name,
                                    item["index"],
                                ),
                        }
                        for item
                        in interfaces
                    ],
            }
        )

    finally:
        conn.close()


def main():
    if len(sys.argv) < 2:
        fail(
            "Comando nao informado."
        )


    command = sys.argv[1]


    if command == "health":
        if len(sys.argv) != 2:
            fail(
                "Uso: health"
            )

        health()
        return


    if command == "network-ensure":
        if len(sys.argv) != 4:
            fail(
                "Uso: network-ensure "
                "<network> <bridge>"
            )

        network_ensure(
            sys.argv[2],
            sys.argv[3],
        )

        return


    if command == "image-ensure":
        if len(sys.argv) != 4:
            fail(
                "Uso: image-ensure "
                "<vendor> <image-id>"
            )

        image_ensure(
            sys.argv[2],
            sys.argv[3],
        )

        return


    if command == "overlay-ensure":
        if len(sys.argv) != 6:
            fail(
                "Uso: overlay-ensure "
                "<lab-id> <domain> "
                "<vendor> <image-id>"
            )

        overlay_ensure(
            sys.argv[2],
            sys.argv[3],
            sys.argv[4],
            sys.argv[5],
        )

        return


    if command == "vm-ensure":
        if len(sys.argv) != 2:
            fail(
                "Uso: vm-ensure < spec.json"
            )

        vm_ensure()

        return


    fail(
        f"Comando desconhecido: "
        f"{command}"
    )


if __name__ == "__main__":
    try:
        main()

    except SystemExit:
        raise

    except subprocess.CalledProcessError as error:
        message = (
            error.stderr.strip()
            or
            error.stdout.strip()
            or
            str(error)
        )

        fail(
            "Comando externo falhou: "
            f"{message}"
        )

    except Exception as error:
        fail(
            f"Erro interno: {error}"
        )
