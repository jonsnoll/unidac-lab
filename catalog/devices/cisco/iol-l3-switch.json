{
  "schema_version": 1,
  "id": "cisco-iol-l3-switch",
  "name": "L3 Router",
  "vendor": "cisco",
  "category": "switch",
  "kind": "network-appliance",
  "runtime": "iol",
  "driver": "cisco-iol",
  "description": "Cisco IOL Layer 3 router para laboratorios. Boot, lifecycle e console disponiveis.",
  "image_required": true,
  "image_types": [
    "bin"
  ],
  "enabled": true,
  "availability": "available",
  "defaults": {
    "memory_mb": 512,
    "interfaces": 8
  },
  "interfaces": {
    "prefix": "Ethernet",
    "minimum": 4,
    "default": 8,
    "maximum": 16,
    "mode": "dynamic"
  },
  "console": "serial"
}
